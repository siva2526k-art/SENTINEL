# SENTINEL — Environment Configuration & API Keys
# Paste your FREE API Keys below to unlock Tier 2 & Tier 3 Cloud AI Reasoning Models.
# NOTE: Never commit your real .env file with live secrets to GitHub!

# 1. Groq Cloud API Key (Free 70B DeepSeek Models @ 300 t/s)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google AI Studio Gemini API Key (Free 2-Million Token Context Window)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OpenRouter API Key (Free 671B DeepSeek-R1 & 405B Llama Models)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. Optional Enterprise OpenAI API Key
OPENAI_API_KEY=

# 5. System Execution Mode (mock = safe response simulation, real = OS firewall containment)
SENTINEL_RESPONSE_MODE=mock
